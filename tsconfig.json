{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@mesh/protocol": ["packages/protocol/src/index.ts"],
      "@mesh/config": ["packages/config/src/index.ts"],
      "@mesh/event-store": ["packages/event-store/src/index.ts"],
      "@mesh/core": ["packages/core/src/index.ts"],
      "@mesh/policy-engine": ["packages/policy-engine/src/index.ts"],
      "@mesh/scheduler": ["packages/scheduler/src/index.ts"],
      "@mesh/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@mesh/artifact-store": ["packages/artifact-store/src/index.ts"],
      "@mesh/runtime-opencode": ["packages/runtime-opencode/src/index.ts"],
      "@mesh/runtime-http": ["packages/runtime-http/src/index.ts"],
      "@mesh/observability": ["packages/observability/src/index.ts"],
      "@mesh/persistence": ["packages/persistence/src/index.ts"],
      "@mesh/projects": ["packages/projects/src/index.ts"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts"],
  // The dashboard is excluded below (it is .tsx, DOM-typed, ESM). `route.ts` is
  // the deliberate exception: it is DOM-free precisely so the routing table can
  // be covered by node:test, and `files` wins over `exclude`.
  "files": ["apps/mesh-dashboard/src/route.ts"],
  "exclude": ["node_modules", "dist", "workspace", "**/workspace/**", "apps/mesh-dashboard/src/**/*", "apps/mesh-dashboard/vite.config.mts"]
}
