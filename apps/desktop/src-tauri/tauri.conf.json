{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curule",
  "version": "0.1.0",
  "identifier": "dev.curule.desktop",
  "build": {
    "devUrl": "https://app.curule.dev",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Curule",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "url": "index.html",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https: http:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "Ali Tabatabaei",
    "copyright": "© 2026 Ali Tabatabaei",
    "shortDescription": "Curule in a native window.",
    "longDescription": "The Curule desktop shell: the hosted app at app.curule.dev in a window of its own, with the machine's own browser kept out of the way and the app's links opening where they belong.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1000
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
