{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curule",
  "version": "0.2.2",
  "identifier": "dev.curule.desktop",
  "build": {
    "devUrl": "https://app.curule.dev",
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/stage-pages.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Curule",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "url": "app/index.html",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https: http:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "Ali Tabatabaei",
    "copyright": "© 2026 Ali Tabatabaei",
    "shortDescription": "Curule in a native window.",
    "longDescription": "The Curule desktop shell: the dashboard in a window of its own, carried in the installer and served from the app rather than the network, with the machine's own browser kept out of the way and the app's links opening where they belong.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 2001
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
