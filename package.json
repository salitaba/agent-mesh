{
  "name": "agent-mesh",
  "version": "0.1.0",
  "private": true,
  "description": "A runtime for creating and executing persistent AI organizations.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:only": "node --test \"dist/tests/**/*.test.js\"",
    "mesh": "node dist/apps/mesh-cli/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
