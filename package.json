{
  "name": "curule",
  "version": "0.1.0",
  "private": true,
  "description": "A runtime for creating and executing persistent AI organizations.",
  "license": "BUSL-1.1",
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "bin": {
    "curule": "apps/mesh-cli/bin/curule.mjs",
    "mesh": "apps/mesh-cli/bin/mesh.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ui",
    "build:ui": "vite build --config apps/mesh-dashboard/vite.config.mts",
    "dev:ui": "vite --config apps/mesh-dashboard/vite.config.mts",
    "dev": "concurrently -k -n host,ui \"npm run curule -- host --port 7420\" \"npm run dev:ui\"",
    "dev:console": "concurrently -k -n mesh,ui \"npm run curule -- console examples/demo-stub/mesh.yaml --port 7421\" \"MESH_BUS_URL=http://127.0.0.1:7421 npm run dev:ui\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "schemas:sync": "node scripts/sync-schemas.mjs",
    "pricing:export": "node scripts/export-pricing.mjs",
    "pricing:check": "node scripts/export-pricing.mjs --check",
    "brand:build": "node scripts/build-brand.mjs",
    "brand:check": "node scripts/build-brand.mjs --check",
    "site:domain": "node scripts/set-domain.mjs",
    "site:check": "node scripts/set-domain.mjs --check",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:only": "node --test \"dist/tests/**/*.test.js\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage \"dist/tests/**/*.test.js\"",
    "test:coverage:only": "node --test --experimental-test-coverage \"dist/tests/**/*.test.js\"",
    "curule": "node dist/apps/mesh-cli/src/index.js",
    "mesh": "node dist/apps/mesh-cli/src/index.js",
    "cloud": "node apps/cloud-server/bin/curule-cloud.mjs",
    "demo:capture": "node scripts/capture-demo.mjs",
    "qa:console": "node scripts/qa-console.mjs",
    "qa:walk": "node scripts/qa-walk.mjs",
    "qa:cloud": "node scripts/qa-cloud.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc --noEmit -p apps/mesh-dashboard/tsconfig.json",
    "lint": "eslint packages apps tests"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^8.11.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  }
}
