{
  "name": "agent-mesh",
  "version": "0.1.0",
  "private": true,
  "description": "A runtime for creating and executing persistent AI organizations.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ui",
    "build:ui": "vite build --config apps/mesh-dashboard/vite.config.mts",
    "dev:ui": "vite --config apps/mesh-dashboard/vite.config.mts",
    "dev": "concurrently -k -n mesh,ui \"npm run mesh -- console examples/demo-stub/mesh.yaml --port 7421\" \"npm run dev:ui\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:only": "node --test \"dist/tests/**/*.test.js\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage \"dist/tests/**/*.test.js\"",
    "test:coverage:only": "node --test --experimental-test-coverage \"dist/tests/**/*.test.js\"",
    "mesh": "node dist/apps/mesh-cli/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc --noEmit -p apps/mesh-dashboard/tsconfig.json",
    "lint": "eslint packages apps tests"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^7.29.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  }
}
